const canvas = document.getElementById('canvas');
const colorBtns = document.querySelectorAll('.color-btn');
const clearBtn = document.querySelector('.Clear-button');
let selectedColor = 'white'; // Default brush

// 1. Create the 20x20 grid (400 cells)
for (let i = 0; i < 400; i++) {
    const cell = document.createElement('div');
    cell.classList.add('cell');
    
    // Painting: Change cell color when clicked
    cell.addEventListener('click', () => {
        cell.style.backgroundColor = selectedColor;
    });
    
    canvas.appendChild(cell);
}

// 2. Selection: Update the 'selectedColor' variable
colorBtns.forEach(btn => {
    btn.addEventListener('click', () => {
        selectedColor = btn.style.backgroundColor;
    });
});

// 3. Clear: Reset all cells to white
clearBtn.addEventListener('click', () => {
    const cells = document.querySelectorAll('.cell');
    cells.forEach(cell => {
        cell.style.backgroundColor = 'white'; 
    });
});